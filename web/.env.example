# Backend base URL (include /api if your routes live under it)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Socket.IO server (optional: defaults to the API url without /api)
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Demo account token. NOTE: NEXT_PUBLIC_ means it ships in the browser bundle,
# so the backend must restrict what the demo user can do.
NEXT_PUBLIC_DEMO_TOKEN=

# true = every API call returns local mock data (no backend needed)
NEXT_PUBLIC_USE_MOCK=true
